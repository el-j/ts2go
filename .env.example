# TS2Go Docker Compose Environment Variables
# Copy this file to .env and update the values

# Database Configuration
POSTGRES_USER=ts2go
POSTGRES_PASSWORD=change_this_secure_password_in_production
POSTGRES_DB=ts2go_saas

# Redis Configuration
REDIS_PASSWORD=change_this_redis_password_in_production

# MinIO (S3-compatible storage) Configuration
MINIO_ROOT_USER=ts2go
MINIO_ROOT_PASSWORD=change_this_minio_password_in_production
STORAGE_BUCKET=ts2go-files

# JWT Configuration
JWT_SECRET=change_this_to_a_very_long_random_string_in_production
JWT_EXPIRY=24h

# API Server Configuration
API_PORT=8080
ENV=development
LOG_LEVEL=debug

# Worker Configuration
WORKER_CONCURRENCY=4

# Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:8080
NEXT_PUBLIC_WS_URL=ws://localhost:8080

# IMPORTANT: For production deployments:
# 1. Generate strong random passwords for all password fields
# 2. Use a cryptographically secure random string for JWT_SECRET (at least 64 characters)
# 3. Set ENV=production
# 4. Adjust LOG_LEVEL to info or warn
# 5. Never commit your .env file to version control
