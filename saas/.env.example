# Environment Configuration for ts2go SaaS

# Server
PORT=8080
ENV=development
LOG_LEVEL=debug

# Database (PostgreSQL)
DATABASE_URL=postgres://ts2go:ts2go_dev_password@localhost:5432/ts2go_saas?sslmode=disable
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=5
DB_CONN_MAX_LIFETIME=5m

# Redis
REDIS_URL=redis://:ts2go_redis_password@localhost:6379/0
REDIS_PASSWORD=ts2go_redis_password
REDIS_DB=0

# JWT Authentication
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRY=24h
JWT_REFRESH_EXPIRY=168h

# Storage (MinIO / S3)
STORAGE_ENDPOINT=localhost:9000
STORAGE_ACCESS_KEY=ts2go
STORAGE_SECRET_KEY=ts2go_minio_password
STORAGE_BUCKET=ts2go-files
STORAGE_USE_SSL=false

# ⚠️ IMPORTANT: Change all passwords and secrets in production!
